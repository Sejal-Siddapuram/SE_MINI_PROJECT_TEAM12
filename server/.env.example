# Copy this file to "server/.env" to override the defaults. All values are optional.

# Port the API listens on
PORT=5000

# MongoDB connection string. Leave EMPTY to use the built-in local database
# (data is stored in server/.data). Example for MongoDB Atlas:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/campusready
MONGO_URI=

# Secret used to sign login tokens (JWT) and how long a login lasts
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=2h

# Default TPO/Admin account created on first start
ADMIN_EMAIL=admin@campusready.edu
ADMIN_PASSWORD=Admin@1234

# Front-end address allowed by CORS
CLIENT_ORIGIN=http://localhost:5173
